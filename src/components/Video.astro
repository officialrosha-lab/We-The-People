---
import { url } from '../lib/url';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  poster: ImageMetadata;
  /** Describes what the video shows, for people who cannot see it. */
  posterAlt: string;
  /** WebVTT captions. When missing, the player says so. */
  captions?: string | undefined;
  /** Plain-text transcript, paragraphs separated by a blank line. */
  transcript?: string | undefined;
  title: string;
  /** Human-readable length, e.g. "1 min 30 s". */
  duration: string;
}
const { src, poster, posterAlt, captions, transcript, title, duration } =
  Astro.props;
const p = await getImage({ src: poster, width: 640, format: 'webp' });
---

<figure class="video">
  <!-- No autoplay, no sound until the viewer presses play, and the video itself downloads only then.
       The poster still image is attached when the video is near the screen, so it never competes with the page's main photo. -->
  <video
    controls
    preload="none"
    playsinline
    data-poster={p.src}
    width={p.attributes.width}
    height={p.attributes.height}
    aria-label={title}
  >
    <source src={url(src)} type="video/mp4" />
    {captions && (
      <track
        kind="captions"
        src={url(captions)}
        srclang="en"
        label="English captions"
        default
      />
    )}
    <p>
      Your browser cannot play this video. <a href={url(src)}>Download it</a>.
    </p>
  </video>
  <figcaption>
    {title} ({duration}).
    {captions && ' Captions are on by default.'}
  </figcaption>
  <p class="desc">What the video shows: {posterAlt}</p>
  {transcript && (
    <details>
      <summary>Read the transcript</summary>
      <div class="transcript">
        {transcript.split(/\n\n+/).map((para) => (
          <p>{para}</p>
        ))}
      </div>
    </details>
  )}
</figure>

<script>
  // Attach each video's poster when the video comes within about 400px of the screen, so the still image never competes
  // with the page's main photo (without JavaScript the box simply stays dark).
  const videos =
    document.querySelectorAll<HTMLVideoElement>('video[data-poster]');
  const attach = (v: HTMLVideoElement) => {
    v.poster = v.dataset.poster ?? '';
  };
  if (videos.length) {
    if (!('IntersectionObserver' in window)) videos.forEach(attach);
    else {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            attach(e.target as HTMLVideoElement);
            io.unobserve(e.target);
          }),
        { rootMargin: '400px 0px' },
      );
      videos.forEach((v) => io.observe(v));
    }
  }
</script>

<style>
  .video {
    margin: 0;
  }
  video {
    display: block;
    inline-size: 100%;
    block-size: auto;
    background: var(--night);
  }
  figcaption,
  .desc {
    margin-block-start: var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .desc {
    margin-block-end: 0;
  }
  details {
    margin-block-start: var(--s-3);
    max-inline-size: var(--measure);
  }
  summary {
    min-block-size: 44px;
    display: flex;
    align-items: center;
    font-family: var(--font-ui);
    font-weight: 600;
    cursor: pointer;
  }
  .transcript {
    margin-block-start: var(--s-2);
  }
</style>
