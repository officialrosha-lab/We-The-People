---
import { getEntry } from 'astro:content';
import ActionForm from './ActionForm.astro';
const neutrality = await getEntry('pages', 'neutrality');
---

<footer class="section site-footer" data-ground="night">
  <div class="wrap">
    <p>
      <strong>We The People Movement</strong>
    </p>
    {neutrality && <p>{neutrality.body}</p>}
    <h2 class="footer-h">Get updates</h2>
    <ActionForm kind="newsletter" submitLabel="Subscribe" />
    <ul>
      <li>
        <a href="/record/">Record</a>
      </li>
      <li>
        <a href="/transparency/">Transparency</a>
      </li>
      <li>
        <a href="/press/">Press</a>
      </li>
      <li>
        <a href="/search/">Search</a>
      </li>
      <li>
        <a href="/contact/">Contact</a>
      </li>
      <li>
        <a href="/privacy/">Privacy</a>
      </li>
      <li>
        <a href="/accessibility/">Accessibility</a>
      </li>
    </ul>
    <p>
      We The People, Inc. [PLACEHOLDER: registration number, address, funding
      statement, social links]
    </p>
  </div>
</footer>
