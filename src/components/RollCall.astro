---
import { url } from '../lib/url';
import { getCollection } from 'astro:content';
import map from '../data/liberia-map.json';

interface Props {
  heading: string;
  sub: string;
}
const { heading, sub } = Astro.props;
const names = map.counties.map((c) => c.name);

// The outreach network: a symbolic link between every pair of counties that share a border. Built from the map
// geometry, so nothing is invented. It does not say where branches or offices are.
const rings = map.counties.map((c) =>
  c.d
    .split('M')
    .filter(Boolean)
    .map((r) => {
      const n = r.match(/-?\d+(?:\.\d+)?/g)!.map(Number);
      const pts: [number, number][] = [];
      for (let i = 0; i + 1 < n.length; i += 2) pts.push([n[i]!, n[i + 1]!]);
      return pts;
    }),
);
const centroid = (pts: [number, number][]) => {
  let a = 0;
  let x = 0;
  let y = 0;
  for (let i = 0; i < pts.length; i++) {
    const [x0, y0] = pts[i]!;
    const [x1, y1] = pts[(i + 1) % pts.length]!;
    const f = x0 * y1 - x1 * y0;
    a += f;
    x += (x0 + x1) * f;
    y += (y0 + y1) * f;
  }
  return [x / (3 * a), y / (3 * a)] as [number, number];
};
const nodes = rings.map((r) => {
  const biggest = r.reduce((m, q) => (q.length > m.length ? q : m), r[0]!);
  const [x, y] = centroid(biggest);
  return { x: Math.round(x), y: Math.round(y) };
});
const adjacent = (a: number, b: number) => {
  let close = 0;
  for (const ra of rings[a]!)
    for (const [ax, ay] of ra)
      for (const rb of rings[b]!)
        for (const [bx, by] of rb)
          if (Math.hypot(ax - bx, ay - by) < 3) close++;
  return close >= 2;
};
const pairs: [number, number][] = [];
for (let a = 0; a < nodes.length; a++)
  for (let b = a + 1; b < nodes.length; b++)
    if (adjacent(a, b)) pairs.push([a, b]);
// The wave starts in the county of the movement's earliest published story (the 7 August 2025 march: Montserrado).
// If no story names a county, it starts from the county nearest the geographic middle of the map.
const stories = (await getCollection('stories')).sort(
  (x, y) => x.data.date.getTime() - y.data.date.getTime(),
);
const storyCounty = stories.find((st) => st.data.county)?.data.county;
const byName = map.counties.findIndex((c) => c.name === storyCounty);
const mx = nodes.reduce((t, n) => t + n.x, 0) / nodes.length;
const my = nodes.reduce((t, n) => t + n.y, 0) / nodes.length;
const middle = nodes.reduce(
  (best, n, i) =>
    Math.hypot(n.x - mx, n.y - my) <
    Math.hypot(nodes[best]!.x - mx, nodes[best]!.y - my)
      ? i
      : best,
  0,
);
const start = byName >= 0 ? byName : middle;
const depth = nodes.map(() => Infinity);
depth[start] = 0;
for (let k = 0; k < nodes.length; k++)
  for (const [a, b] of pairs) {
    if (depth[a]! + 1 < depth[b]!) depth[b] = depth[a]! + 1;
    if (depth[b]! + 1 < depth[a]!) depth[a] = depth[b]! + 1;
  }
const edges = pairs.map(([a, b]) => {
  const [from, to] = depth[a]! <= depth[b]! ? [a, b] : [b, a];
  return {
    from: nodes[from]!,
    to: nodes[to]!,
    order: Math.min(depth[a]!, depth[b]!),
  };
});
const nodeDepth = nodes.map((_, i) => depth[i]!);
---

<section class="roll section" data-ground="night" aria-labelledby="hero-title">
  <script is:inline>
    (function () {
      var d = document.documentElement;
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && !sessionStorage.getItem('wtp-roll')) {
          d.setAttribute('data-roll', 'pending');
          // Safety net: if the sequence script never runs, show the final state.
          setTimeout(function () {
            d.removeAttribute('data-roll');
          }, 8000);
        }
      } catch (e) {}
    })();
  </script>
  <div class="wrap roll-grid">
    <p class="placard" aria-hidden="true">
      <span class="placard-we">We</span>
      <span class="placard-line">
        <span data-caller>The people</span>
      </span>
    </p>
    <svg
      class="roll-map"
      viewBox={map.viewBox}
      aria-hidden="true"
      focusable="false"
    >
      {map.counties.map((c) => (
        <path id={c.id} data-name={c.name} d={c.d} />
      ))}
      <g class="net">
        {edges.map((e) => (
          <path
            class="net-edge"
            pathLength="1"
            style={`--o:${e.order}`}
            data-order={e.order}
            data-x1={e.from.x}
            data-y1={e.from.y}
            data-x2={e.to.x}
            data-y2={e.to.y}
            d={`M${e.from.x} ${e.from.y}L${e.to.x} ${e.to.y}`}
          />
        ))}
        <g class="flow-layer">
          {edges.map((e) => (
            <>
              <path
                class="net-glow"
                pathLength="1"
                style={`--o:${e.order}`}
                d={`M${e.from.x} ${e.from.y}L${e.to.x} ${e.to.y}`}
              />
              <path
                class="net-light"
                pathLength="1"
                style={`--o:${e.order}`}
                d={`M${e.from.x} ${e.from.y}L${e.to.x} ${e.to.y}`}
              />
            </>
          ))}
        </g>
        {nodes.map((n, i) => (
          <circle
            class="net-node"
            style={`--o:${nodeDepth[i]}`}
            cx={n.x}
            cy={n.y}
            r="6"
          />
        ))}
      </g>
    </svg>
    <div class="roll-copy">
      <h1 id="hero-title" class="reveal">
        {heading}
      </h1>
      <p class="reveal roll-sub">{sub}</p>
      <p class="reveal roll-actions">
        <a class="btn" href={url('/join/')}>
          Join the movement
        </a>
        <a class="btn btn-quiet" href={url('/about/')}>
          Read what we stand for
        </a>
      </p>
      <p class="flow-control" hidden>
        <button type="button" class="flow-toggle" aria-pressed="false">
          Pause the moving light
        </button>
      </p>
    </div>
    <ul class="sr-only">
      {names.map((n) => (
        <li>{n}</li>
      ))}
    </ul>
  </div>
</section>

<script>
  const root = document.documentElement;
  const caller = document.querySelector<HTMLElement>('[data-caller]');
  const paths = Array.from(
    document.querySelectorAll<SVGPathElement>('.roll-map path[data-name]'),
  );

  // Act two: once every county is lit, the network links draw outward from the middle of the map, and small gold dots
  // travel along them, county to county. It plays once and settles; any click, key or scroll finishes it at once.
  const svg = document.querySelector<SVGSVGElement>('.roll-map');
  // Act three: light keeps travelling outward along the links, wave after wave from the first county. It can be paused
  // with the button, stops while the map is off screen, and never starts under reduced motion.
  let flowing = false;
  function startFlow() {
    if (flowing || !svg) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    flowing = true;
    svg.classList.add('flow');
    const control = document.querySelector<HTMLElement>('.flow-control');
    const toggle = control?.querySelector<HTMLButtonElement>('button');
    if (control && toggle) {
      control.hidden = false;
      toggle.addEventListener('click', () => {
        const paused = svg.classList.toggle('flow-paused');
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.textContent = paused
          ? 'Play the moving light'
          : 'Pause the moving light';
      });
    }
    if ('IntersectionObserver' in window)
      new IntersectionObserver(([entry]) =>
        svg.classList.toggle('flow-offscreen', !entry?.isIntersecting),
      ).observe(svg);
  }
  const NS = 'http://www.w3.org/2000/svg';
  const HOP = 520; // ms between one ring of counties and the next
  const TRAVEL = 720;
  function runNetwork() {
    if (!svg) return;
    const dots: Animation[] = [];
    const made: SVGCircleElement[] = [];
    const finish = () => {
      dots.forEach((a) => a.cancel());
      made.forEach((c) => c.remove());
      svg.classList.add('net-done');
      startFlow();
      ['pointerdown', 'keydown', 'wheel', 'touchmove'].forEach((t) =>
        removeEventListener(t, finish),
      );
    };
    svg.classList.add('net-on');
    svg.querySelectorAll<SVGPathElement>('.net-edge').forEach((edge, i) => {
      const d = edge.dataset;
      const order = Number(d.order);
      const delay = order * HOP + (i % 4) * 60;
      edge.style.transitionDelay = `${delay}ms`;
      const dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('r', '9');
      dot.setAttribute('class', 'net-dot');
      svg.querySelector('.net')!.appendChild(dot);
      made.push(dot);
      dots.push(
        dot.animate(
          [
            {
              transform: `translate(${d.x1}px, ${d.y1}px)`,
              opacity: 0,
            },
            {
              transform: `translate(${d.x1}px, ${d.y1}px)`,
              opacity: 1,
              offset: 0.15,
            },
            {
              transform: `translate(${d.x2}px, ${d.y2}px)`,
              opacity: 1,
              offset: 0.85,
            },
            { transform: `translate(${d.x2}px, ${d.y2}px)`, opacity: 0 },
          ],
          { duration: TRAVEL, delay, fill: 'both', easing: 'ease-in-out' },
        ),
      );
    });
    const longest = Math.max(
      ...Array.from(dots, (a) => Number(a.effect?.getComputedTiming().endTime)),
    );
    window.setTimeout(finish, longest + 100);
    ['pointerdown', 'keydown', 'wheel', 'touchmove'].forEach((t) =>
      addEventListener(t, finish, { passive: true }),
    );
  }

  if (root.dataset.roll === 'pending' && caller) {
    const timers: number[] = [];
    const final = caller.textContent ?? '';
    let ended = false;

    const end = () => {
      if (ended) return;
      ended = true;
      timers.forEach(clearTimeout);
      paths.forEach((p) => p.classList.add('lit'));
      caller.textContent = final;
      delete root.dataset.roll;
      try {
        sessionStorage.setItem('wtp-roll', '1');
      } catch {
        /* storage unavailable: sequence may replay, which is harmless */
      }
      if (svg && !svg.classList.contains('net-on')) startFlow();
      removeEventListener('pointerdown', end);
      removeEventListener('keydown', end);
      removeEventListener('wheel', end);
      removeEventListener('touchmove', end);
    };
    addEventListener('pointerdown', end);
    addEventListener('keydown', end);
    addEventListener('wheel', end, { passive: true });
    addEventListener('touchmove', end, { passive: true });

    const STEP = 340; // under 3 name changes per second (WCAG 2.3.1)
    const START = 400;
    caller.textContent = '';
    paths.forEach((path, i) => {
      timers.push(
        window.setTimeout(
          () => {
            root.dataset.roll = 'running';
            caller.textContent = path.dataset.name ?? '';
            path.classList.add('lit');
          },
          START + i * STEP,
        ),
      );
    });
    const done = START + paths.length * STEP; // about 5.5s
    timers.push(window.setTimeout(runNetwork, done));
    timers.push(
      window.setTimeout(() => {
        root.dataset.roll = 'called';
        caller.textContent = final;
      }, done),
    );
    timers.push(window.setTimeout(end, done + 800)); // about 6.3s: headline and actions fade in
  }

  if (root.dataset.roll !== 'pending') startFlow();
</script>

<style>
  .roll {
    padding-block: var(--s-5) var(--s-6);
  }
  .roll-grid {
    display: grid;
    gap: var(--s-4) var(--s-5);
    grid-template-areas: 'placard' 'map' 'copy';
  }
  .placard {
    grid-area: placard;
  }
  .roll-map {
    grid-area: map;
  }
  .roll-copy {
    grid-area: copy;
  }
  @media (min-width: 900px) {
    .roll-grid {
      grid-template-columns: 7fr 5fr;
      grid-template-areas: 'placard map' 'copy map';
      grid-template-rows: auto 1fr;
    }
  }
  .placard {
    margin: 0 0 var(--s-4);
    max-inline-size: none;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    text-transform: uppercase;
    line-height: var(--lh-display);
    font-size: clamp(3.5rem, 1.5rem + 13vw, 12rem);
    color: var(--chalk);
  }
  .placard-we,
  .placard-line {
    display: block;
  }
  /* Reserve the final line height on the wrapper so the sequence causes no layout shift. */
  .placard-line {
    block-size: 0.88em;
    white-space: nowrap;
  }
  .placard-line > span {
    display: block;
  }
  html[data-roll='running'] .placard-line > span {
    font-size: 0.4em;
    line-height: 2.2;
    color: var(--gold);
  }
  .roll h1 {
    font-size: var(--step-3);
    font-stretch: 90%;
    text-transform: none;
    font-weight: 800;
    line-height: 1;
  }
  .roll-sub {
    font-size: var(--step-1);
  }
  .roll-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-4);
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .roll-map {
    inline-size: 100%;
    max-block-size: 45vh;
    justify-self: start;
  }
  .roll-map path[data-name] {
    fill: var(--white);
    stroke: var(--night);
    stroke-width: 2;
    transition: fill var(--dur-1) var(--ease);
  }
  html[data-roll] .roll-map path[data-name]:not(.lit) {
    fill: none;
    stroke: color-mix(in srgb, var(--chalk) 25%, transparent);
  }

  /* The outreach network. Final state (no animation, reduced motion, no JavaScript): quiet navy links and gold nodes. */
  .net-edge {
    fill: none;
    stroke: var(--navy);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.55;
    pointer-events: none;
  }
  .net-node {
    fill: var(--gold);
    stroke: var(--night);
    stroke-width: 2;
  }
  :global(.net-dot) {
    fill: var(--red);
    stroke: var(--white);
    stroke-width: 3;
    opacity: 0;
  }
  /* While the roll call runs the links are hidden; when it finishes they draw outward. */
  html[data-roll] .roll-map:not(.net-on) .net-edge {
    stroke-dashoffset: 1;
  }
  html[data-roll] .roll-map:not(.net-on) .net-node {
    opacity: 0;
  }
  .roll-map.net-on .net-edge {
    transition: stroke-dashoffset 720ms var(--ease);
  }
  .roll-map.net-on .net-node {
    transition: opacity 240ms var(--ease) calc(var(--o) * 520ms);
  }

  /* Light travelling along the links: a soft gold glow with a bright red core, wave after wave outward. */
  .flow-layer {
    opacity: 0;
    pointer-events: none;
  }
  .net-glow,
  .net-light {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 0.16 1;
    stroke-dashoffset: 0.16;
  }
  .net-glow {
    stroke: var(--gold);
    stroke-width: 15;
    opacity: 0.6;
  }
  .net-light {
    stroke: var(--red);
    stroke-width: 6;
  }
  .roll-map.flow .flow-layer {
    opacity: 1;
  }
  .roll-map.flow .net-glow,
  .roll-map.flow .net-light {
    animation: net-flow 4.8s linear infinite;
    animation-delay: calc(var(--o) * 520ms);
  }
  .roll-map.flow-paused .flow-layer {
    opacity: 0;
  }
  .roll-map.flow-paused .net-glow,
  .roll-map.flow-paused .net-light,
  .roll-map.flow-offscreen .net-glow,
  .roll-map.flow-offscreen .net-light {
    animation-play-state: paused;
  }
  @keyframes net-flow {
    0% {
      stroke-dashoffset: 0.16;
    }
    45%,
    100% {
      stroke-dashoffset: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-layer {
      display: none;
    }
  }
  .flow-toggle {
    min-block-size: 44px;
    padding-inline: var(--s-3);
    border: 0;
    background: transparent;
    color: var(--muted-light);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .flow-toggle:hover {
    color: var(--white);
  }

  .reveal {
    transition: opacity var(--dur-3) var(--ease);
  }
  html[data-roll] .reveal {
    opacity: 0;
  }
</style>
