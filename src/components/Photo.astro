---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string | undefined;
  credit?: string | undefined;
  /** Responsive sizes attribute, describing how wide the photo shows on screen. */
  sizes: string;
  /** Only for the photo at the top of the page: loads first. */
  priority?: boolean;
}
const { src, alt, caption, credit, sizes, priority = false } = Astro.props;
---

<figure class="photo">
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[400, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
  {(caption || credit) && (
    <figcaption>
      {caption}
      {caption && credit ? ' ' : ''}
      {credit && <span class="credit">Photo: {credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .photo {
    margin: 0;
  }
  .photo :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-block);
  }
  figcaption {
    margin-block-start: var(--s-2);
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--fg-muted);
  }
  .credit {
    white-space: nowrap;
  }
</style>
