---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ActionForm from '../components/ActionForm.astro';
const page = await getEntry('pages', 'contact');
if (!page) throw new Error('content/pages/contact.md is missing');
const { Content } = await render(page);
---

<Base
  title={page.data.title}
  description={page.data.description}
  ground="night"
>
  <PageHeader title={page.data.title} />
  <section class="section">
    <div class="wrap prose">
      <Content />
    </div>
  </section>
  <section class="section" data-ground="night">
    <div class="wrap">
      <h2>Send a message</h2>
      <ActionForm kind="contact" submitLabel="Send" />
    </div>
  </section>
</Base>
