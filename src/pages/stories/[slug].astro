---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Video from '../../components/Video.astro';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((s) => ({ params: { slug: s.id }, props: { story: s } }));
}
const { story } = Astro.props;
const { Content } = await render(story);
const [lead, ...more] = story.data.images;
const shareImage = lead
  ? await getImage({
      src: lead.src,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
    })
  : null;
// Preload the lead photo (it is the largest thing on screen) in the format the browser will pick.
// Same widths the Picture component offers: the standard steps below the original, plus the original width.
const leadWidths = lead
  ? [
      ...new Set([
        ...[400, 800, 1200, 1600].filter((w) => w < lead.src.width),
        lead.src.width,
      ]),
    ]
  : [];
const leadSet = lead
  ? await Promise.all(
      leadWidths.map(async (w) => {
        const i = await getImage({
          src: lead.src,
          width: w,
          format: 'avif',
        });
        return `${i.src} ${w}w`;
      }),
    )
  : [];
const org = { '@type': 'Organization', name: 'We The People, Inc.' };
const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={story.data.title}
  description={story.data.summary}
  image={lead?.src}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: story.data.title,
    description: story.data.summary,
    datePublished: story.data.date.toISOString().slice(0, 10),
    author: org,
    publisher: org,
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    ...(shareImage && Astro.site
      ? { image: [new URL(shareImage.src, Astro.site).toString()] }
      : {}),
  }}
>
  {lead && leadSet.length > 0 && (
    <link
      slot="head"
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={leadSet.join(', ')}
      imagesizes="(min-width: 1600px) 1500px, 92vw"
      fetchpriority="high"
    />
  )}
  <article>
    <section class="section">
      <div class="wrap head">
        <h1>{story.data.title}</h1>
        <p class="meta">
          {story.data.byline},{' '}
          <time datetime={story.data.date.toISOString().slice(0, 10)}>
            {fmt.format(story.data.date)}
          </time>
        </p>
      </div>
      {lead && (
        <div class="wrap">
          <Photo {...lead} sizes="(min-width: 1600px) 1500px, 92vw" priority />
        </div>
      )}
    </section>
    <section class="section">
      <div class="wrap prose">
        <Content />
      </div>
    </section>
    {story.data.video && (
      <section class="section">
        <div class="wrap video-wrap">
          <h2>Watch</h2>
          <Video {...story.data.video} />
        </div>
      </section>
    )}
    {more.length > 0 && (
      <section class="section">
        <div class="wrap gallery">
          {more.map((img) => (
            <Photo {...img} sizes="(min-width: 900px) 55vw, 92vw" />
          ))}
        </div>
      </section>
    )}
    <section class="section" data-ground="night">
      <div class="wrap">
        <p>
          <a class="btn" href={url('/join/')}>
            Join the movement
          </a>
        </p>
        <p>
          <a href={url('/stories/')}>All stories</a>
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .video-wrap {
    max-inline-size: 960px;
  }
  .head h1 {
    text-transform: none;
    font-size: var(--step-4);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.95;
    max-inline-size: 16ch;
  }
  .meta {
    font-family: var(--font-ui);
    color: var(--fg-muted);
  }
  .gallery {
    display: grid;
    gap: var(--s-4);
    align-items: start;
  }
  @media (min-width: 900px) {
    /* Uneven columns on purpose: portrait photos sit in the narrow column. */
    .gallery {
      grid-template-columns: 5fr 7fr;
    }
  }
</style>
