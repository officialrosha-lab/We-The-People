---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ActionForm from '../../components/ActionForm.astro';
import { fmtDate, fmtTime } from '../../lib/events';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((e) => ({ params: { slug: e.id }, props: { event: e } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const isPast = (event.data.end ?? event.data.start).getTime() < Date.now();
---

<Base title={event.data.title} description={event.data.summary} ground="night">
  <PageHeader title={event.data.title} intro={event.data.summary} />
  <section class="section">
    <div class="wrap prose">
      <p>
        <time datetime={event.data.start.toISOString()}>
          {fmtDate.format(event.data.start)}, {fmtTime.format(event.data.start)}{' '}
          (Monrovia time)
        </time>
      </p>
      <p>{event.data.place}</p>
      <Content />
      {!isPast && (
        <p>
          <a href={`/events/${event.id}.ics`}>Add to calendar</a>
        </p>
      )}
    </div>
  </section>
  {event.data.registration && !isPast && (
    <section class="section" data-ground="night">
      <div class="wrap">
        <h2>Register</h2>
        <ActionForm
          kind="event"
          submitLabel="Register"
          extra={{ event: event.data.title }}
        />
      </div>
    </section>
  )}
</Base>
