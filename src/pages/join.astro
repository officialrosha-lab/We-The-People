---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
const page = await getEntry('pages', 'join');
if (!page) throw new Error('content/pages/join.md is missing');
---

<Base title={page.data.title} description={page.data.description}>
  <section class="section" data-ground="red">
    <div class="wrap">
      <h1>Join the movement</h1>
      <p class="lead">{page.body}</p>
      <p>
        [PLACEHOLDER: join form (name, email or phone, county, how you want to
        help). Built in Phase 4.]
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap prose">
      <h2>What happens after you join</h2>
      <p>
        [PLACEHOLDER: what the movement does with a new member's details and how
        soon someone makes contact]
      </p>
      <h2>Your information</h2>
      <p>
        [PLACEHOLDER: privacy in plain words: what we collect, why, who sees it,
        how to be removed. Needs legal review.]
      </p>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2.6rem, 1.5rem + 7vw, 7rem);
  }
  .lead {
    font-size: var(--step-1);
  }
</style>
