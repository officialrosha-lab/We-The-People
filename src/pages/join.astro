---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ActionForm from '../components/ActionForm.astro';
const page = await getEntry('pages', 'join');
if (!page) throw new Error('content/pages/join.md is missing');
---

<Base title={page.data.title} description={page.data.description}>
  <section class="section" data-ground="red">
    <div class="wrap">
      <h1>Join the movement</h1>
      <p class="lead">{page.body}</p>
      <div class="join-grid">
        <ActionForm kind="join" submitLabel="Join the movement" />
        <aside class="after" aria-label="What happens to your details">
          <h2>What happens after you join</h2>
          <p>
            We contact you using the email address or phone number you gave.
            [PLACEHOLDER: how soon, and who contacts you]
          </p>
          <h2>Your information</h2>
          <p>
            We ask for your name, a way to reach you and your county, so that we
            can put you in touch with the people near you. [PLACEHOLDER: who
            sees it, how long it is kept, how to be removed; needs legal review]
          </p>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2.6rem, 1.5rem + 7vw, 7rem);
  }
  .lead {
    font-size: var(--step-1);
  }
  .join-grid {
    display: grid;
    gap: var(--s-5);
  }
  .after h2 {
    color: var(--white);
    font-size: var(--step-1);
    margin-block: 0 var(--s-2);
  }
  .after h2:not(:first-child) {
    margin-block-start: var(--s-4);
  }
  @media (min-width: 1000px) {
    .join-grid {
      grid-template-columns: minmax(0, 36rem) minmax(0, 28rem);
      column-gap: var(--s-7);
      align-items: start;
      justify-content: start;
    }
    .after {
      padding-block-start: var(--s-5);
      border-inline-start: 4px solid var(--white);
      padding-inline-start: var(--s-4);
    }
  }
</style>
