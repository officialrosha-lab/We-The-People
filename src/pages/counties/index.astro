---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CountyIndex from '../../components/CountyIndex.astro';
const page = await getEntry('pages', 'counties');
if (!page) throw new Error('content/pages/counties.md is missing');
---

<Base
  title={page.data.title}
  description={page.data.description}
  ground="night"
>
  <PageHeader title="Fifteen counties" intro={page.body} />
  <section class="section">
    <div class="wrap">
      <CountyIndex />
    </div>
  </section>
</Base>
