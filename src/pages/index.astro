---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('content/pages/home.md is missing');
const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title={home.data.title}
  description={home.data.description}
  ground="night"
>
  <section class="section hero" data-ground="night">
    <div class="wrap">
      <!-- Phase 2 replaces this static state with the Roll Call hero. -->
      <h1>
        Fifteen counties.
        <br />
        One table.
      </h1>
      <p>
        We The People Movement brings Liberians of every party, faith and
        background to the same table to work on what affects ordinary people.
      </p>
      <a class="btn" href="/join/">
        Join the movement
      </a>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <p class="statement">{home.body}</p>
    </div>
  </section>
  <section class="section" data-ground="night">
    <div class="wrap">
      <h2>What we are working on</h2>
      <ul class="rows">
        {programs.map((p) => (
          <li>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero h1 {
    font-size: clamp(3rem, 2rem + 11vw, 11rem);
    font-stretch: 62%;
    font-weight: 900;
    margin-block-end: var(--s-4);
    overflow-wrap: anywhere;
  }
  .statement {
    font-size: var(--step-2);
    line-height: 1.3;
    max-inline-size: 28em;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    border-block-start: 1px solid var(--muted-light);
    padding-block: var(--s-4);
  }
  .rows h3 {
    margin-block-end: var(--s-1);
  }
</style>
