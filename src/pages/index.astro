---
import { url } from '../lib/url';
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RollCall from '../components/RollCall.astro';
import CountyIndex from '../components/CountyIndex.astro';
import Photo from '../components/Photo.astro';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('content/pages/home.md is missing');
const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order,
);
const record = (await getCollection('record')).sort(
  (a, b) => a.data.date.getTime() - b.data.date.getTime(),
);
const stories = (await getCollection('stories')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const leadStory = stories[0];
const march = stories.find((x) => x.id === '2025-08-march-to-the-capitol');
const marchPhoto = (name: string) =>
  march?.data.images.find((i) => i.src.src.includes(name));
const marchLead = marchPhoto('march-stage-rain');
const marchStrip = ['march-banner', 'march-speaker', 'march-press']
  .map(marchPhoto)
  .filter((x) => x !== undefined);
const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={home.data.title}
  description={home.data.description}
  ground="night"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'NGO',
    name: 'We The People, Inc.',
    alternateName: 'We The People Movement',
    url: new URL(url('/'), Astro.site).toString(),
    description: home.data.description,
  }}
>
  <RollCall
    heading="Fifteen counties. One table."
    sub="We The People Movement brings Liberians of every party, faith and background to the same table to work on what affects ordinary people."
  />
  <section class="section">
    <div class="wrap">
      <p class="statement">{home.body}</p>
    </div>
  </section>
  {march && marchLead && (
    <section class="section" data-ground="navy">
      <div class="wrap">
        <div class="story-lead march">
          <Photo
            src={marchLead.src}
            alt={marchLead.alt}
            sizes="(min-width: 900px) 58vw, 92vw"
          />
          <div>
            <p class="kicker">
              <time datetime="2025-08-07">7 August 2025</time>
            </p>
            <h2>Thousands marched in the rain</h2>
            <p>{march.data.summary}</p>
            <p>
              <a href={url(`/stories/${march.id}/`)}>
                Read the story and watch the speech
              </a>
            </p>
          </div>
        </div>
        <ul class="strip">
          {marchStrip.map((i) => (
            <li>
              <Photo
                src={i.src}
                alt={i.alt}
                sizes="(min-width: 900px) 30vw, 92vw"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section class="section" data-ground="night">
    <div class="wrap">
      <h2>What we are working on</h2>
      <ul class="rows">
        {programs.map((p) => (
          <li>
            <h3>
              <a href={url(`/our-work/${p.id}/`)}>{p.data.title}</a>
            </h3>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>Find your county</h2>
      <CountyIndex />
    </div>
  </section>
  <section class="section" data-ground="night">
    <div class="wrap">
      <h2>The record</h2>
      <ul class="rows">
        {record.map((e) => (
          <li>
            <time datetime={e.data.date.toISOString().slice(0, 10)}>
              {fmt.format(e.data.date)}
            </time>
            <h3>{e.data.title}</h3>
          </li>
        ))}
      </ul>
      <p>
        <a href={url('/record/')}>Read the full record</a>
      </p>
    </div>
  </section>
  {leadStory && (
    <section class="section">
      <div class="wrap story-lead">
        {leadStory.data.images[0] && (
          <Photo
            src={leadStory.data.images[0].src}
            alt={leadStory.data.images[0].alt}
            sizes="(min-width: 900px) 58vw, 92vw"
          />
        )}
        <div>
          <h2>From the field</h2>
          <h3>
            <a href={url(`/stories/${leadStory.id}/`)}>
              {leadStory.data.title}
            </a>
          </h3>
          <p>{leadStory.data.summary}</p>
          <p>
            <a href={url('/stories/')}>All stories</a>
          </p>
        </div>
      </div>
    </section>
  )}
  <section class="section" data-ground="red">
    <div class="wrap cta">
      <h2>The table is open</h2>
      <p>
        Membership is open to everybody. You do not have to leave your party.
      </p>
      <p>
        <a class="btn" href={url('/join/')}>
          Join the movement
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .statement {
    font-size: var(--step-2);
    line-height: 1.3;
    max-inline-size: 28em;
  }
  .rows {
    list-style: none;
    margin: 0 0 var(--s-4);
    padding: 0;
  }
  .rows li {
    border-block-start: 1px solid var(--muted-light);
    padding-block: var(--s-4);
  }
  .rows h3 {
    margin-block-end: var(--s-1);
  }
  .rows h3 a {
    color: var(--heading);
  }
  time {
    font-family: var(--font-ui);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--fg-muted);
  }
  .story-lead {
    display: grid;
    gap: var(--s-4);
    align-items: end;
  }
  .story-lead h3 {
    font-size: var(--step-3);
    font-stretch: 90%;
  }
  .story-lead h3 a {
    color: var(--heading);
  }
  @media (min-width: 900px) {
    .story-lead {
      grid-template-columns: 7fr 5fr;
    }
  }
  .kicker {
    margin: 0;
  }
  .march h2 {
    font-size: var(--step-3);
    margin-block: var(--s-1) var(--s-3);
  }
  .march a {
    color: var(--heading);
  }
  .strip {
    list-style: none;
    margin: var(--s-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  /* Same shape for all three so the row is tidy; the photos are cropped, not stretched. */
  .strip :global(img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (min-width: 700px) {
    .strip :global(img) {
      aspect-ratio: 4 / 3;
    }
    .strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cta {
    text-align: center;
  }
  .cta p {
    margin-inline: auto;
  }
</style>
