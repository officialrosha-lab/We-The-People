---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
  title="Search"
  description="Search the We The People Movement website."
  ground="night"
  index={false}
>
  <PageHeader title="Search" />
  <section class="section" data-ground="night">
    <div class="wrap">
      <div
        id="search"
        data-pagefind={url('/pagefind/')}
        data-base={url('/').replace(/\/$/, '')}
      ></div>
      <noscript>
        <p>
          Search needs JavaScript. You can still use the menu, the{' '}
          <a href={url('/counties/')}>county list</a> and the{' '}
          <a href={url('/stories/')}>stories</a>.
        </p>
      </noscript>
      <p id="search-fail" hidden>
        Search could not load. Use the menu, the{' '}
        <a href={url('/counties/')}>county list</a> or the{' '}
        <a href={url('/stories/')}>stories</a> instead.
      </p>
    </div>
  </section>
</Base>

<script>
  // Pagefind builds its index when the site is built; it is downloaded only on this page.
  const mount = document.querySelector('#search');
  const fail = document.querySelector<HTMLElement>('#search-fail');
  const base = mount?.getAttribute('data-pagefind') ?? '/pagefind/';
  const site = mount?.getAttribute('data-base') ?? '';
  (async () => {
    try {
      await new Promise<void>((resolve, reject) => {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = `${base}pagefind-ui.css`;
        document.head.append(css);
        const js = document.createElement('script');
        js.src = `${base}pagefind-ui.js`;
        js.onload = () => resolve();
        js.onerror = () => reject(new Error('pagefind-ui failed to load'));
        document.head.append(js);
      });
      const PagefindUI = (
        window as unknown as { PagefindUI: new (o: object) => unknown }
      ).PagefindUI;
      new PagefindUI({
        element: mount,
        baseUrl: site + '/',
        bundlePath: base,
        showImages: false,
        showSubResults: false,
        resetStyles: false,
        translations: {
          placeholder: 'Search the site',
          zero_results:
            'No results for [SEARCH_TERM]. Try a county name or a single word.',
        },
      });
    } catch {
      if (fail) fail.hidden = false;
    }
  })();
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--red-tint);
    --pagefind-ui-text: var(--chalk);
    --pagefind-ui-background: var(--night);
    --pagefind-ui-border: var(--muted-light);
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--font-ui);
    max-inline-size: 48rem;
  }
  #search .pagefind-ui__search-input {
    border-radius: var(--radius-pill);
    min-block-size: 56px;
    color: var(--night);
    background: var(--white);
    font-weight: 600;
  }
  #search .pagefind-ui__result-link {
    color: var(--chalk);
  }
</style>
