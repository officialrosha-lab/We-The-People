---
import { url } from '../lib/url';
import '../styles/fonts.css';
import archivoLatin from '../../node_modules/@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import serifLatin from '../../node_modules/@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { allowSearchEngines } from '../lib/site';
import { csp } from '../lib/csp';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  ground?: 'night' | 'chalk';
  /** Include this page in site search. */
  index?: boolean;
  /** Photo used for link previews (WhatsApp, Facebook). */
  image?: ImageMetadata | undefined;
  /** Structured data (schema.org) for this page. */
  jsonLd?: object | undefined;
}
const {
  title,
  description,
  ground = 'chalk',
  image,
  index = true,
  jsonLd,
} = Astro.props;
// Pages without a photo share public/og-default.png (made by scripts/build-og.mjs; replace it when the real logo exists).
const og = image
  ? await getImage({
      src: image,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
    })
  : null;
const fullTitle =
  title === 'We The People Movement'
    ? title
    : `${title} | We The People Movement`;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      document.documentElement.classList.add('menu-js');
    </script>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {!allowSearchEngines && <meta name="robots" content="noindex, nofollow" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link
      rel="preload"
      href={archivoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={serifLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content={
        og
          ? new URL(og.src, Astro.site).toString()
          : new URL(url('/og-default.png'), Astro.site).toString()
      }
    />
    <meta
      property="og:image:alt"
      content={
        og
          ? title
          : 'We The People Movement: a white map of Liberia’s fifteen counties beside the words We The People.'
      }
    />
    <meta property="og:site_name" content="We The People Movement" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div
      data-ground={ground === 'night' ? 'night' : undefined}
      class="section"
      style="padding-block: 0"
    >
      <div class="wrap">
        <Header />
      </div>
    </div>
    <main id="main" data-pagefind-body={index ? '' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
