# Third-party services that receive the site's forms. Both values are public (they end up in the page HTML),
# so never put an API key or secret here. See docs/13-form-integrations.md for setup.

# Formspree: receives Join, Contact and Event registration. Looks like https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_ENDPOINT=

# Brevo: receives newsletter sign-ups. The form action URL of a Brevo sign-up form,
# looks like https://xxxxxxxx.sibforms.com/serve/xxxxxxxx...
PUBLIC_BREVO_FORM_URL=
